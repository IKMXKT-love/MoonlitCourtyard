# Publish current game code and configuration only.
# Local handoff notes, drafts, production tools, assets and recordings stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-TW.md
!/README.en.md
!/README.ja.md
!/README.ko.md
!/CREDITS.md
!/MoonlitCourtyard.uproject
!/Config/
!/Source/
/Source/*
!/Source/MoonlitCourtyard/
!/Source/CourtyardAnimationEditor/
!/Source/MoonlitCourtyard.Target.cs
!/Source/MoonlitCourtyardEditor.Target.cs
__pycache__/
*.pyc

# Public README screenshots only; production media remains private.
!/assets/
/assets/*
!/assets/readme/
/assets/readme/*
!/assets/readme/courtyard.webp
!/assets/readme/companion.webp
!/assets/readme/manor.webp
!/assets/readme/hearth.webp
!/assets/readme/reading.webp

!/assets/readme/garden.webp
